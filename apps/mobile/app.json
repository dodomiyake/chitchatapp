{
  "expo": {
    "name": "ChitChat",
    "slug": "chitchat",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/chitchat-icon-light-1024.png",
    "userInterfaceStyle": "light",
    "scheme": "chitchat",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chitchat.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/chitchat-icon-light-1024.png",
        "backgroundColor": "#f8f9fd"
      },
      "package": "com.chitchat.app"
    },
    "web": {
      "favicon": "./assets/brand/chitchat-icon-light-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9fd",
          "image": "./assets/brand/chitchat-icon-light-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
