# ChitChat V2 — local development placeholders only.
# Copy to apps/api/.env and apps/web/.env as needed.
# Do not put real secrets, production URLs, or credentials here.

# --- API (apps/api) ---
NODE_ENV=development
PORT=5000
# Optional local MongoDB. Leave empty in M1 to skip DB connection.
MONGO_URI=
CLIENT_ORIGIN=http://localhost:5173
# Placeholder for later milestones — do not use a real secret in examples.
JWT_SECRET=replace-me-in-local-env-only
COOKIE_SECURE=false

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
